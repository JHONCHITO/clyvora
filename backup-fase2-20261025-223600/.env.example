# Copia este archivo como .env.local y aÃ±ade tu clave. Nunca publiques esta clave.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Acceso privado y biblioteca de videos.
CLYVORA_PANEL_PASSWORD=
CLYVORA_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
MEDIA_MAX_UPLOAD_BYTES=2147483648

# Conexiones sociales oficiales. Guárdalas en Vercel y en .env.local, nunca en Git.
DATABASE_URL=
SOCIAL_TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://clyvora-lac.vercel.app/api/oauth/tiktok/callback
TIKTOK_SCOPES=user.info.basic

# Meta: se activará cuando crees y apruebes la app de Meta.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://clyvora-lac.vercel.app/api/oauth/meta/callback
