# Copy to .env.local. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

DATABASE_URL=
SOCIAL_TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://clyvora-lac.vercel.app/api/oauth/tiktok/callback
TIKTOK_SCOPES=user.info.basic

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://clyvora-lac.vercel.app/api/oauth/meta/callback

# Single-owner access. Password hash format: 32 hex salt : 128 hex scrypt digest.
CLYVORA_OWNER_PASSWORD_HASH=
# Random hexadecimal secret of 64 to 128 characters.
CLYVORA_SESSION_SECRET=
